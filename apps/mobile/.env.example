# Base URL the mobile app uses to reach apps/api.
# - iOS simulator: http://localhost:3000 (default, works out of the box)
# - Android emulator: http://10.0.2.2:3000 (localhost refers to the emulator itself)
# - Physical device via Expo Go: http://<your-machine-LAN-IP>:3000
#   Match the IP Metro prints (exp://<IP>:8081). Restart Expo after changing.
EXPO_PUBLIC_API_URL=http://localhost:3000

# When 1 (default in __DEV__), log API requests/responses to the Metro console.
# Set to 0 to silence. Ignored in production builds.
EXPO_PUBLIC_DEV_LOGS=1
