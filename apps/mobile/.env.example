# Base URL the mobile app uses to reach apps/api.
# - iOS simulator: http://localhost:3000 (default, works out of the box)
# - Android emulator: http://10.0.2.2:3000 (localhost refers to the emulator itself)
# - Physical device via Expo Go: http://<your-machine-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
