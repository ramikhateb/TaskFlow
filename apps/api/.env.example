NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

# Signs/verifies access tokens. Must be at least 32 characters. Generate a
# real value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Never commit a real secret here — this is a placeholder only.
JWT_ACCESS_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Access token lifetime, in seconds (default 900 = 15 minutes).
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=30
