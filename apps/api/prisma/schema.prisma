// User and RefreshToken introduced in M2, per docs/DATABASE.md §4.
// Task introduced in M3 (self-owned only: creator == assignee always, no
// TaskAssignment yet). M4 adds priority/category/scheduledAt/deadline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  tasksCreated  Task[]         @relation("TaskCreator")
  tasksAssigned Task[]         @relation("TaskAssignee")

  @@index([name])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  category    String?

  // scheduledAt: when the assignee plans to work on it.
  // deadline: when it must be done by. Independent — neither implies the
  // other (FR-8) — but when both are set, deadline >= scheduledAt is
  // enforced in the service layer, not here (EC-13; see taskService.ts).
  scheduledAt DateTime?
  deadline    DateTime?

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Always the current responsible party; changes only when a TaskAssignment
  // is ACCEPTED (introduced in M8+). In M3 always equal to creatorId.
  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // Not in DATABASE.md's original schema — added additively for M3's
  // complete/uncomplete UX. Set when status transitions to DONE, cleared
  // whenever it transitions away from DONE.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([assigneeId, scheduledAt])
  @@index([assigneeId, deadline])
  @@index([assigneeId, category])
  @@index([creatorId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  familyId  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}
