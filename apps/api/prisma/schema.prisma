// User and RefreshToken introduced in M2, per docs/DATABASE.md §4.
// Task introduced in M3 (self-owned only: creator == assignee always, no
// TaskAssignment yet). M4 adds priority/category/scheduledAt/deadline.
// M7 adds User.username, required + unique — added nullable, backfilled
// (see prisma/backfillUsernames.ts), then made required, across three
// migrations so existing rows were never at risk (docs/DATABASE.md §Migration
// Strategy has the full sequence).
// M8 adds TaskAssignment (create + cancel only — accept/decline are M9).
// Creating a PENDING assignment never changes Task.assigneeId; only an M9
// ACCEPTED transition will. See docs/DATABASE.md §3/§6 for the full
// creator/assignee/assignment invariant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // M7: public product identity, used for discovery/collaboration — always
  // stored pre-lowercased (see normalizeUsername in @taskflow/shared), so
  // this plain @unique constraint IS the case-insensitive uniqueness
  // enforcement; no citext/collation trick needed.
  username     String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens       RefreshToken[]
  tasksCreated        Task[]           @relation("TaskCreator")
  tasksAssigned       Task[]           @relation("TaskAssignee")
  assignmentsSent     TaskAssignment[] @relation("AssignmentFrom")
  assignmentsReceived TaskAssignment[] @relation("AssignmentTo")

  @@index([name])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  category    String?

  // scheduledAt: when the assignee plans to work on it.
  // deadline: when it must be done by. Independent — neither implies the
  // other (FR-8) — but when both are set, deadline >= scheduledAt is
  // enforced in the service layer, not here (EC-13; see taskService.ts).
  scheduledAt DateTime?
  deadline    DateTime?

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  // Always the current responsible party; changes only when a TaskAssignment
  // is ACCEPTED (introduced in M8+). In M3 always equal to creatorId.
  assigneeId String
  assignee   User   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // Not in DATABASE.md's original schema — added additively for M3's
  // complete/uncomplete UX. Set when status transitions to DONE, cleared
  // whenever it transitions away from DONE.
  completedAt DateTime?

  assignments TaskAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([assigneeId, scheduledAt])
  @@index([assigneeId, deadline])
  @@index([assigneeId, category])
  @@index([creatorId])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

// M8: a proposal to transfer assignee-ship, with its own lifecycle,
// independent of Task.status. Creating one does NOT touch Task.assigneeId —
// only an ACCEPTED transition would (M9). CANCELLED/DECLINED/ACCEPTED rows
// are kept as history, never deleted or overwritten (EC-6).
//
// "At most one PENDING assignment per task" (FR-21) is enforced by a
// partial unique index added by hand in this model's migration SQL —
// `CREATE UNIQUE INDEX ... ON "TaskAssignment"("taskId") WHERE status =
// 'PENDING'` — since Prisma's schema DSL has no syntax for partial/filtered
// unique indexes (still true as of Prisma 5). This updates DATABASE.md's
// original note that the rule is "enforced in the service layer... not as a
// structural constraint": M8 adds the structural constraint as the actual
// concurrency guarantee (a service-layer pre-check still runs first, purely
// for a fast/friendly error message) — see the M8 report for the full
// rationale. taskId itself is intentionally NOT unique on its own, since a
// task legitimately accumulates many non-pending assignment rows over time.
model TaskAssignment {
  id      String           @id @default(cuid())
  status  AssignmentStatus @default(PENDING)
  message String?

  // onDelete: Cascade — deleting a task removes its (by then all
  // non-PENDING, per FR-13/EC-5) assignment history with it, per EC-7.
  // Deletion itself is blocked outright while a PENDING row exists (see
  // taskRepository.deleteIfNotPending), so this cascade only ever fires
  // against CANCELLED/DECLINED/ACCEPTED history rows.
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromUserId String
  fromUser   User   @relation("AssignmentFrom", fields: [fromUserId], references: [id])

  toUserId String
  toUser   User   @relation("AssignmentTo", fields: [toUserId], references: [id])

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([taskId, status])
  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  familyId  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}
